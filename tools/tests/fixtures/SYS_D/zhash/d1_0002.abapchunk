OP AT lt_cats INTO DATA(ls_cats).
    ls_log-pernr = ls_cats-pernr.
    ls_log-hours = ls_cats-catshours.
    ls_log-text  = zcl_util_string=>pad_left( iv_text = ls_cats-rproj iv_len = 24 ).
    MODIFY zhrts_log FROM ls_log.
  ENDLOOP.
  CALL FUNCTION 'CATS_READ_RECORDS'
    EXPORTING pernr = pernr-pernr.
END-OF-SELECTION.
  AUTHORITY-CHECK OBJECT 'P_ORGIN' ID 'INFTY' FIELD '0001'.
* ###END_PROGRAM ZD_REPORT
###END_OBJECT
###OBJECT          D66:FUNC:Z_D_AUTH_CHECK     FUNC    Z_D_AUTH_CHECK
FUNCTION z_d_auth_check.
*"  Checks authorization objects
  AUTHORITY-CHECK OBJECT 'S_TCODE' ID 'TCD' FIELD iv_tcode.
  SELECT SINGLE * FROM usr02 INTO @DATA(ls_u) WHERE bname = @sy-uname.
ENDFUNCTION.
* 