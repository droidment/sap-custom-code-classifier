###OBJECT          D66:FUNC:Z_D_AUTH_LOG     FUNC    Z_D_AUTH_LOG
FUNCTION z_d_auth_log.
*"  Logs authorization failures
  INSERT zd_auth_log FROM @is_log.
ENDFUNCTION.
