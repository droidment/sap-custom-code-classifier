{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "edit": {
      "*": "ask",
      "work/**": "allow",
      "output/**": "allow",
      "migration.config.json": "ask",
      "tools/taxonomy/rules_custom.json": "ask"
    },
    "shell": {
      "*": "ask",
      "py tools/*": "allow",
      "py -I tools/*": "allow",
      "dir *": "allow",
      "ls *": "allow",
      "type *": "allow",
      "cat *": "allow",
      "findstr *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow"
    },
    "webfetch": "deny",
    "task": {
      "*": "deny",
      "abap-*": "allow"
    }
  }
}
